---
import Layout from '../layouts/Layout.astro';
import Form from '../components/Form/Form';
---

<Layout title="Space4Ads - Monetize your empty real estate">
    <main>
        <center><img src="/Space4Ads.png" width="250px"></center>
        <p>We Turn Window Space Into Ads</p>

        <p>Revenues for Vacant Spaces</p>

        <p>Street-Level Ads for Brands</p>
        <Form client:only="react" />
    </main>
</Layout>

<style>

    main {
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        font-size: 20px;
        line-height: 1.6;
        text-align: center;
        font-family: "Open Sans", sans-serif;;
    }
</style>
